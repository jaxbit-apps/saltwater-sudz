{
  "meta": {
    "name": "Saltwater Sudz Design System",
    "version": "1.0.0",
    "created": "2026-03-23",
    "sources": {
      "primary": "v1-tile3 (Lowcountry Light) -- colors, typography, cards, buttons, spacing, motion",
      "secondary": "v1-tile1 (Tidewater Clean) -- wave dividers, wave-line animations, dot grid patterns, SVG wave section transitions"
    },
    "wcag": {
      "standard": "WCAG 2.1 AA",
      "verification": "All token pairings verified at 4.5:1 minimum for normal text, 3:1 for large text. Primary color adjusted from #0077B6 to #006BA5 to achieve universal AA compliance on all background surfaces including sand (#F5F0EB).",
      "audit": {
        "body-on-white": "12.68:1",
        "body-on-sand": "11.20:1",
        "heading-on-white": "16.76:1",
        "heading-on-sand": "14.80:1",
        "muted-on-white": "5.74:1",
        "muted-on-sand": "5.07:1",
        "primary-on-white": "5.76:1",
        "primary-on-sand": "5.09:1",
        "white-on-primary-btn": "5.76:1",
        "white-on-hover-btn": "7.39:1",
        "white-on-navy-hero": "16.76:1",
        "dark-body-on-dark-bg": "11.38:1",
        "dark-heading-on-dark-bg": "14.94:1",
        "dark-muted-on-dark-bg": "6.07:1",
        "dark-primary-on-dark-bg": "5.70:1"
      }
    }
  },
  "tokens": {
    "colors": {
