        "textMuted": "#5A6872",
        "ctaBg": "#006BA5",
        "ctaBgHover": "#005A8C",
        "ctaText": "#FFFFFF",
        "secondaryBorder": "#006BA5",
        "secondaryText": "#006BA5",
        "secondaryHoverBg": "rgba(0, 107, 165, 0.06)",
        "divider": "rgba(11, 29, 59, 0.08)",
        "overlaySoft": "rgba(245, 240, 235, 0.5)",
        "cardShadow": "0 2px 12px rgba(11, 29, 59, 0.06), 0 1px 4px rgba(11, 29, 59, 0.04)",
        "cardShadowHover": "0 8px 32px rgba(11, 29, 59, 0.10), 0 2px 8px rgba(11, 29, 59, 0.06)"
      },
      "dark": {
        "background": "#0F1923",
        "surface": "#162231",
        "surfaceAlt": "#1C2D3F",
        "surfaceAccent": "#1A2A3A",
        "text": "#E8ECF0",
        "textBody": "#C8D0D8",
        "textMuted": "#8899AA",
        "ctaBg": "#3399DD",
        "ctaBgHover": "#2B84C4",
        "ctaText": "#0F1923",
        "secondaryBorder": "#3399DD",
        "secondaryText": "#3399DD",
        "secondaryHoverBg": "rgba(51, 153, 221, 0.1)",
        "divider": "rgba(232, 236, 240, 0.08)",
        "overlaySoft": "rgba(22, 34, 49, 0.5)",
        "cardShadow": "0 2px 12px rgba(0, 0, 0, 0.25), 0 1px 4px rgba(0, 0, 0, 0.15)",
        "cardShadowHover": "0 8px 32px rgba(0, 0, 0, 0.35), 0 2px 8px rgba(0, 0, 0, 0.2)"
      },
      "brand": {
        "navy": "#0B1D3B",
        "tealBlue": "#006BA5",
        "tealBlueHover": "#005A8C",
        "sand": "#F5F0EB",
        "warmCharcoal": "#2D3436",
        "warmWhite": "#FAFBFC",
        "softGray": "#F0F2F5"
      },
      "decorative": {
        "embellishOpacityLight": 0.12,
        "embellishOpacityDark": 0.08,
        "waveColorLight": "rgba(0, 107, 165, 0.06)",
        "waveColorDark": "rgba(51, 153, 221, 0.06)",
        "dotColorLight": "rgba(0, 107, 165, 0.08)",
        "dotColorDark": "rgba(51, 153, 221, 0.08)",
        "grainOpacityLight": 0.03,
        "grainOpacityDark": 0.04
      }
    },
    "typography": {
      "heading": {
        "family": "Outfit",
        "fallback": "sans-serif",
        "weights": [300, 400, 500, 600, 700, 800],
        "googleFontsUrl": "https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap"
      },
      "body": {
        "family": "Nunito",
        "fallback": "sans-serif",
        "weights": [400, 500, 600, 700],
        "googleFontsUrl": "https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800&display=swap"
      },
      "scale": 1.25,
      "bodySize": "17px",
      "lineHeight": 1.65,
      "headingSizes": {
        "h1": "clamp(2.2rem, 4vw, 3.052rem)",
        "h2": "clamp(1.6rem, 3vw, 2.441rem)",
        "h3": "clamp(1.2rem, 2vw, 1.563rem)"
      },
      "headingLineHeights": {
        "h1": 1.1,
        "h2": 1.15,
        "h3": 1.25
      },
      "headingLetterSpacing": {
        "h1": "-0.02em",
        "h2": "-0.01em",
        "h3": "0"
      },
      "label": {
        "size": "0.65rem",
        "weight": 500,
        "letterSpacing": "0.1em",
        "transform": "uppercase"
      },
      "small": {
        "size": "0.82rem",
        "lineHeight": 1.5
      },
      "link": {
        "decorationThickness": "1.5px",
        "underlineOffset": "3px",
        "hoverTransition": "color 0.25s ease, text-decoration-color 0.25s ease"
      }
    },
    "spacing": {
      "density": "generous",
      "unit": "1rem",
      "xs": "0.5rem",
      "sm": "1rem",
      "md": "1.5rem",
      "lg": "2.5rem",
      "xl": "4rem",
      "xxl": "6rem",
      "sectionGap": "5rem",
      "elementGap": "1.5rem"
    },
    "motion": {
      "level": "subtle",
      "hoverTransition": "all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94)",
      "entranceStyle": "fade-up",
      "entranceDuration": "0.7s",
      "entranceStagger": "0.1s",
      "animations": {
        "fadeUp": {
          "from": { "opacity": 0, "transform": "translateY(16px)" },
          "to": { "opacity": 1, "transform": "translateY(0)" }
        },
        "waveShift": {
          "from": { "transform": "translateX(-2%)" },
          "to": { "transform": "translateX(2%)" }
        },
        "floatGentle": {
          "0%": { "transform": "translate(0, 0)" },
          "33%": { "transform": "translate(5px, -8px)" },
          "66%": { "transform": "translate(-3px, 5px)" },
          "100%": { "transform": "translate(0, 0)" }
        },
        "waveFloat": {
          "0%": { "transform": "translateX(0) scaleY(1)" },
          "25%": { "transform": "translateX(2%) scaleY(2.5)" },
          "50%": { "transform": "translateX(-1%) scaleY(1)" },
          "75%": { "transform": "translateX(1.5%) scaleY(2)" },
          "100%": { "transform": "translateX(0) scaleY(1)" }
        },
        "dotPulse": {
          "0%": { "opacity": 0.07 },
          "50%": { "opacity": 0.12 },
          "100%": { "opacity": 0.07 }
        }
      }
    },
    "surfaces": {
      "borderRadius": {
        "sm": "6px",
        "md": "10px",
        "lg": "16px",
        "xl": "24px",
        "pill": "50px"
      },
      "cardShadow": "0 2px 12px rgba(11, 29, 59, 0.06), 0 1px 4px rgba(11, 29, 59, 0.04)",
      "cardHoverShadow": "0 8px 32px rgba(11, 29, 59, 0.10), 0 2px 8px rgba(11, 29, 59, 0.06)",
      "cardHoverLift": "translateY(-6px)",
      "cardTransition": "transform 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94), box-shadow 0.35s ease"
    },
    "embellishments": {
      "source": "Tidewater Clean (v1-tile1), recolored to Lowcountry Light palette",
      "waveDivider": {
        "description": "SVG wave shapes between sections, using smooth cubic bezier curves",
        "height": "48px",
        "svgViewBox": "0 0 1440 48",
        "paths": {
          "gentle": "M0,24 C360,48 720,0 1080,24 C1260,36 1380,12 1440,24 L1440,48 L0,48 Z",
          "complex": "M0,16 C180,48 360,0 540,24 C720,48 900,0 1080,24 C1260,48 1380,8 1440,16 L1440,48 L0,48 Z",
          "simple": "M0,24 C480,48 960,0 1440,24 L1440,48 L0,48 Z",
          "heroWave": "M0,28 C240,56 480,0 720,28 C960,56 1200,0 1440,28 L1440,56 L0,56 Z"
        },
        "fillLight": "var(--bg-primary) or var(--bg-secondary) depending on section transition",
        "fillDark": "same custom properties adapt via dark mode"
      },
      "waveLines": {
        "description": "Animated horizontal wave lines that gently shift and scale, used as background decoration",
        "lineCount": 5,
        "lineHeight": "2px",
        "color": "var(--cta-bg)",
        "opacityRange": [0.05, 0.10],
        "animation": "waveFloat 6s ease-in-out infinite",
        "staggerDelay": "1s per line"
      },
      "dotGrid": {
        "description": "Radial gradient dot pattern used as subtle background texture",
        "dotSize": "1.2px to 1.5px",
        "gridSpacing": "16px to 20px",
        "color": "var(--cta-bg)",
        "opacity": "var(--embellish-opacity)",
        "animation": "dotPulse 4s ease-in-out infinite"
      },
      "curvedDividers": {
        "description": "CSS clip-path ellipse overlays creating organic section breaks",
        "technique": "clip-path: ellipse(55% 100% at 50% 100%)",
        "source": "Lowcountry Light card image bottoms"
      },
      "ambientOrbs": {
        "description": "Radial gradient circles floating in hero sections",
        "sizes": ["200px", "120px", "80px"],
        "colors": ["rgba(51, 153, 221, 0.12)", "rgba(0, 107, 165, 0.08)", "rgba(245, 240, 235, 0.06)"],
        "animation": "floatGentle 8-14s ease-in-out infinite"
      },
      "grainTexture": {
        "description": "SVG feTurbulence noise overlay for subtle surface texture",
        "opacity": "var(--grain-opacity)",
        "backgroundSize": "128px 128px"
      }
    },
    "components": {
      "card": {
        "borderRadius": "16px",
        "imageHeight": "180px",
        "imageOverlay": "clip-path: ellipse(55% 100% at 50% 100%) with surface color",
        "tagStyle": {
          "fontSize": "0.68rem",
          "fontWeight": 600,
          "letterSpacing": "0.1em",
          "textTransform": "uppercase",
          "background": "rgba(0, 0, 0, 0.25)",
          "backdropFilter": "blur(8px)",
          "borderRadius": "6px",
          "padding": "5px 12px"
        },
        "bodyPadding": "1.5rem 1.5rem 2.5rem",
        "hoverTransform": "translateY(-6px)",
        "ctaArrowGapExpand": "0.4em to 0.7em on hover"
      },
      "button": {
        "fontFamily": "Outfit",
        "fontWeight": 600,
        "fontSize": "0.95rem",
        "letterSpacing": "0.02em",
        "transition": "all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94)",
        "variants": {
          "primary": {
            "padding": "14px 32px",
            "borderRadius": "10px",
            "shimmerOverlay": "linear-gradient(90deg, transparent, rgba(255,255,255,0.15), transparent)"
          },
          "secondary": {
            "padding": "13px 30px",
            "borderRadius": "10px",
            "borderWidth": "2px"
          },
          "ghost": {
            "padding": "12px 24px",
            "borderRadius": "10px",
            "borderWidth": "1px"
          },
          "pill": {
            "padding": "12px 28px",
            "borderRadius": "50px"
          }
        },
        "sizes": {
          "sm": { "fontSize": "0.82rem", "padding": "10px 22px" },
          "md": { "fontSize": "0.95rem", "padding": "14px 32px" },
          "lg": { "fontSize": "1.05rem", "padding": "18px 40px" }
        }
      },
      "hero": {
        "background": "linear-gradient(160deg, #0B1D3B 0%, #142E54 50%, #1A3A5C 100%)",
        "borderRadius": "24px",
        "minHeight": "420px",
        "contentMaxWidth": "600px",
        "taglineColor": "#3399DD",
        "titleColor": "#FFFFFF",
        "subtitleColor": "rgba(232, 236, 240, 0.8)"
      },
      "trustBadge": {
        "fontSize": "0.72rem",
        "fontWeight": 600,
        "letterSpacing": "0.1em",
        "textTransform": "uppercase",
        "iconSize": "16px"
      }
    }
  }
}
